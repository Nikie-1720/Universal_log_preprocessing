# Required only when PostgreSQL is enabled
POSTGRES_DB=ulpf
POSTGRES_USER=ulpf
POSTGRES_PASSWORD=Tnikita1800

# Collector authentication
ULPF_AGENT_TOKEN=Tnikita1800
ULPF_ALLOW_UNAUTHENTICATED_AGENT=false
ULPF_OPERATOR_TOKEN=CHANGE_ME_OPERATOR_TOKEN

# HTTPS for the local/private ULPF console (optional)
# ULPF_TLS_CERT=/etc/ulpf/tls/server.crt
# ULPF_TLS_KEY=/etc/ulpf/tls/server.key
# ULPF_TLS_CA=/etc/ulpf/tls/ca.crt
# ULPF_TLS_REQUIRE_CLIENT_CERT=true

Optional local-only AI assistance
ULPF_LOCAL_AI=true
ULPF_LOCAL_AI_ENDPOINT=http://127.0.0.1:11434
ULPF_LOCAL_AI_MODEL=llama3.2:3b
